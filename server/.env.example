# Cyber Chaukidaar server configuration (copy to .env)

PORT=8787
HOST=0.0.0.0

# Number of SIMULATED nodes to run alongside real hardware (0 disables).
# Simulated nodes are clearly labelled in the dashboard.
SIM_NODES=0
# Scenario the simulator starts with: quiet | patrol | vehicle | wind
SIM_SCENARIO=patrol

# Site dimensions in metres (the map)
SITE_WIDTH=40
SITE_HEIGHT=30

# Fusion thresholds
ALERT_THRESHOLD=0.70
CRITICAL_THRESHOLD=0.88
ALERT_COOLDOWN_MS=30000

# Node health
NODE_WARN_MS=45000
NODE_OFFLINE_MS=120000

# Loitering: radar target standing still this long raises a LOITER alert
LOITER_SECONDS=15
# Wake the next node along a track's predicted path (downlink LIVE) so its radar is warm on arrival
PREARM_ENABLED=1

# Notifications (leave empty to disable).
# Telegram: create a bot with @BotFather and paste its token here (or in Setup > Notifications).
# Then open the bot in Telegram and press Start: the server discovers your chat id by itself.
# TELEGRAM_CHAT_ID is optional (comma-separated ids override discovery, e.g. for a group).
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Raspberry Pi GPIO (BCM number) driving a relay/siren/strobe for SIREN_SECONDS on every new alert (-1 = off)
SIREN_GPIO=-1
SIREN_SECONDS=10

# Optional shared secret nodes must send in the X-Node-Key header (empty = disabled)
NODE_API_KEY=

# Optional: OSINT breach checker upstream (leave empty for the offline dataset)
LEAKOSINT_API_KEY=
LEAKOSINT_API_URL=https://leakosintapi.com/

# ============================================================
# Hackathon sponsor integrations (all optional; absent = disabled)
# ============================================================

# --- TigerData / TimescaleDB (Tiger Cloud) ---
# Service connection string from the Tiger Cloud console. New signups get $1000 free credits.
DATABASE_URL=
# Optional dedicated read-only role for Gemini text-to-SQL (defaults to DATABASE_URL).
# Create with: CREATE ROLE readonly LOGIN PASSWORD '...'; GRANT SELECT ON ALL TABLES IN SCHEMA public TO readonly;
DATABASE_URL_RO=
# Write 1 of every N telemetry rows (1 = store everything). Raise it if credits run low.
TS_TELEMETRY_SAMPLING=1
# Escape hatch for odd local TLS only; leave unset in production.
DATABASE_SSL_INSECURE=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# Any current model id (see `GET /v1beta/models`). Free-tier daily limits vary a LOT by model:
#   full flash (e.g. gemini-3.8-flash): ~20 requests/day   | lite (e.g. gemini-flash-lite-latest): ~1000/day
# "gemini-flash-lite-latest" tracks the newest lite and is the cheapest + most generous free option.
# (Pinned ids like gemini-3.1-flash-lite can be 503-overloaded; the floating -latest alias is steadier.)
GEMINI_MODEL=gemini-flash-lite-latest
# Hard per-call timeout (ms) so a slow/overloaded API never stalls an alert or a query.
GEMINI_TIMEOUT_MS=8000
# The simulator raises alerts constantly. On a LITE model (~1000/day) narrating them all is fine,
# so set 1 to show Gemini prose on simulator alerts during a no-hardware demo. On a full flash
# model (~20/day) keep 0 so the simulator can't exhaust the daily cap (real alerts still narrate).
GEMINI_NARRATE_SIM=0


# --- Operator login (production) ---
# Require a PIN for the dashboard/API. Empty = open (fine on a private hotspot/LAN only).
ACCESS_PIN=
# Optional: HMAC key for sessions (auto-generated into data/session.key when empty), lifetime in days.
SESSION_SECRET=
SESSION_DAYS=30
# Key the OLED base station sends (X-Panel-Key) so its buttons still work when ACCESS_PIN is set.
PANEL_KEY=

# --- HTTPS (installable app on phones) ---
# Run `sh scripts/make-cert.sh`, then point these at the generated files.
HTTPS_CERT=
HTTPS_KEY=
HTTPS_PORT=8443

# --- Base station ---
# Show simulated nodes/alerts on the OLED panel too (default: real hardware only).
BASESTATION_SHOW_SIM=0
# Gemini narrations for simulated alerts per hour (real hardware alerts are always narrated).
GEMINI_SIM_PER_HOUR=20
